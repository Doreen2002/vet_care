{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-09-29 17:46:28.188015",
 "css": " * {\r\n    line-height: 1.1 !important;\r\n  }\r\n  table, td, th, p, li {\r\n    font-size: 10px !important;\r\n    margin: 0 !important;\r\n    padding: 1px !important;\r\n  }\r\n  h2, h4 {\r\n    margin: 1px 0 !important;\r\n    padding: 0 !important;\r\n  }\r\n  ol {\r\n    margin-top: 2px !important;\r\n    margin-bottom: 2px !important;\r\n  }\r\n  hr {\r\n    margin: 1px 0 !important;\r\n  }",
 "custom_format": 1,
 "default_print_language": "en-GB",
 "disabled": 0,
 "doc_type": "Grooming Form",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div>\r\n  {% if letter_head and not no_letterhead -%}\r\n    <div class=\"letter-head\">{{ letter_head }}</div>\r\n    <hr>\r\n  {%- endif %}\r\n\r\n  <h2 style=\"text-align:center; margin:2px 0;font-size:14px;\"><b>GROOMING FORM</b></h2>\r\n <hr style=\"margin:2px 0;\">\r\n    <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0; font-size:12px;line-height:1;\">\r\n    <tr style=\"white-space:nowrap;\">\r\n    <td style=\"width:33%; text-align:left;\">\r\n       <strong>Date:</strong> {{ doc.get_formatted(\"date\") or '' }}\r\n    </td>\r\n    <td style=\"width:34%; text-align:left;\">\r\n      <strong>No:</strong> {{ doc.name or ''}}\r\n    </td>\r\n    <td style=\"width:33%; text-align:left;\">\r\n      <strong>Grooming Location:</strong> {{ doc.grooming_location or '' }} \r\n    </td>\r\n  </tr>\r\n    <tr style=\"white-space:nowrap;\">\r\n    <td style=\"width:33%; text-align:left;\">\r\n      <strong>Sales Employee:</strong>\r\n        {{doc.grooming_employee_fullname}}\r\n    </td>\r\n    <td style=\"width:34%; text-align:left;\">\r\n      <strong>Groomer's Name:</strong> \r\n       {{doc.groomer_fullname}}\r\n    </td>\r\n   {% if doc.grooming_location == \"Mobile\" %}\r\n  <td style=\"width:33%; text-align:left;\">\r\n    <strong>Area:</strong> {{ doc.area or ''}} \r\n  </td>\r\n{% endif %}\r\n  </tr>\r\n  </table>\r\n  <hr style=\"margin:2px 0;\">\r\n  <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0;font-size:12px;line-height:1;\">\r\n    <tr>\r\n      <td style=\"text-align:left; width:50%; padding:0;\">\r\n        <strong>Customer Name:</strong> {{doc.customer_fullname or ''}}\r\n      </td>\r\n      <td style=\"text-align:right; width:50%; padding:0;\">\r\n        <strong>CPR No:</strong> {{ doc.cpr_no or '' }}\r\n      </td>\r\n    </tr>\r\n    <tr style=\"white-space:nowrap;\">\r\n    <td style=\"width:33%; text-align:left;\">\r\n      <strong>Mobile No:</strong> {{ doc.contact_no or ''}}\r\n    </td>\r\n    <td style=\"width:34%; text-align:left;\">\r\n      <strong>E-mail:</strong> {{ doc.email or '' }}\r\n    </td>\r\n    <td style=\"width:33%; text-align:left;\">\r\n      <strong>BD:</strong> {{ \" {:.3f}\".format(doc.price or 0) }}\r\n    </td>\r\n  </tr>\r\n </table>\r\n<hr style=\"margin:2px 0;\"><br>\r\n\r\n<table style=\"width:100%; border-collapse:collapse; font-size:11px; border:1px solid #000;\">\r\n  <thead>\r\n    <tr>\r\n      <th style=\"border:1px solid #000; text-align:left; padding:1px 2px; color:black;\"><b>Name of Pet</b></th>\r\n      <th style=\"border:1px solid #000; text-align:left; padding:1px 2px; color:black;\"><b>Type of Animal</b></th>\r\n      <th style=\"border:1px solid #000; text-align:left; padding:1px 2px; color:black;\"><b>Breed</b></th>\r\n      <th style=\"border:1px solid #000; text-align:left; padding:1px 2px; color:black;\"><b>Size</b></th>\r\n      <th style=\"border:1px solid #000; text-align:left; padding:1px 2px; color:black;\"><b>Age</b></th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% if doc.grooming_patient_details %}\r\n      {% for row in doc.grooming_patient_details %}\r\n      <tr>\r\n        <td style=\"border:1px solid #000; padding:1px 2px;\">{{ row.patient_fullname or '' }}</td>\r\n        <td style=\"border:1px solid #000; padding:1px 2px;\">{{row.species or ''}}</td>\r\n        <td style=\"border:1px solid #000; padding:1px 2px;\">{{ row.breed or '' }}</td>\r\n        <td style=\"border:1px solid #000; padding:1px 2px;\">{{ row.size or '' }}</td>\r\n        <td style=\"border:1px solid #000; padding:1px 2px;\">\r\n          {% set age_value = row.age or '' %}\r\n          {% if '-' in age_value and age_value|length == 10 %}\r\n            {{ frappe.utils.format_date(age_value, \"dd-MM-yyyy\") or '' }}\r\n          {% else %}\r\n            {{ age_value or '' }}\r\n          {% endif %}\r\n        </td>\r\n      </tr>\r\n      {% endfor %}\r\n    {% else %}\r\n      <tr>\r\n        <td colspan=\"5\" style=\"border:1px solid #000; text-align:center; padding:4px;\">\r\n          No pet details available.\r\n        </td>\r\n      </tr>\r\n    {% endif %}\r\n  </tbody>\r\n</table>\r\n\r\n  <p><strong>Services:</strong></p>\r\n  <ol>\r\n  {% if doc.full_grooming %}\r\n    <li><p>Full Grooming</p></li>\r\n  {% endif %}\r\n  {% if doc.summer_cur %}\r\n    <li><p>Summer Cut</p></li>\r\n  {% endif %}\r\n  {% if doc.partial_shave %}\r\n    <li><p>Partial Shave</p></li>\r\n  {% endif %}\r\n  {% if doc.full_shaving %}\r\n    <li><p>Full shaving</p></li>\r\n  {% endif %}\r\n    {% if doc.trimming %}\r\n    <li><p>Trimming</p></li>\r\n  {% endif %}\r\n  {% if doc.poodle_cut %}\r\n    <li><p>Poodle Cut</p></li>\r\n  {% endif %}\r\n  {% if doc.lion_cut %}\r\n    <li><p>Lion Cut</p></li>\r\n  {% endif %}\r\n  {% if doc.clipper_blade_size %}\r\n    <li><p>Clipper Blade Size {% if doc.clipper_blade_size_data%} (Blade Size-{{doc. clipper_blade_size_data or ''}}) {% endif %}</p></li>\r\n  {% endif %}\r\n    {% if doc.puppy_cut %}\r\n    <li><p>Puppy Cut</p></li>\r\n  {% endif %}\r\n   {% if doc.basic_grooming %}\r\n    <li><p>Basic Grooming</p></li>\r\n  {% endif %}\r\n  {% if doc.medicated_shower %}\r\n    <li><p>Medicated Shower</p></li>\r\n  {% endif %}\r\n  {% if doc.sanitary_shaving %}\r\n    <li><p>Sanitary Shaving</p></li>\r\n  {% endif %}\r\n     {% if doc.doctor_consultation %}\r\n    <li><p>Doctor Consultation</p></li>\r\n  {% endif %}\r\n  </ol>\r\n  {% if doc.other_services %}\r\n  <p>Other Services - <strong><i>{{ doc.other_services }}</i></strong></p>\r\n{% endif %}\r\n\r\n{% if doc.addtional_request %}\r\n  <p>Additional Requests - <strong><i>{{ doc.addtional_request }}</i></strong></p>\r\n{% endif %}\r\n\r\n{% if doc.any_medical_conditions_or_allergies %}\r\n  <p>Any Medical Conditions or Allergies? <strong><i>{{ doc.any_medical_conditions_or_allergies }}</i></strong></p>\r\n{% endif %}\r\n\r\n{% if doc.comments %}\r\n  <p>Remarks/Comments - <strong><i>{{ doc.comments }}</i></strong></p>\r\n{% endif %}\r\n<table style=\"width:100%; border-collapse:collapse; margin-top:15px !important; padding:0; line-height:1 !important; font-size:9px !important;\">\r\n  <tr>\r\n\r\n    <td style=\"width:50%; vertical-align:top; text-align:left; padding:5px 3px 1px 3px !important; font-size:9px !important; line-height:1 !important;\">\r\n      \r\n      <h6 style=\"margin:3px 0 !important; font-size:9px !important;\">Customer Agreement: My Pets Grooming Services</h6>\r\n      <h6 style=\"font-size:9px !important;\">Terms & Conditions</h6>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">1. My Pets shall not be held responsible, whether directly, indirectly, or consequentially, for any injury, loss, or harm affecting the pet during or after the grooming service, including transportation.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">2. My Pets shall not be liable for any illness, injury, damage, or loss suffered by the pet during or after the service, or arising from the use of any products, equipment, or facilities provided by the company.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">3. My Pets shall not be responsible for any claims for physical, psychological, emotional, moral, or financial compensation.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">4. Grooming services may be refused or cancelled if the pet is ill, injured, aggressive, pregnant, not vaccinated, or is a very young kitten or puppy.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">5. Exceptionally, the service may proceed only if the owner provides written consent accepting full responsibility and all associated risks.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">6. My Pets reserves the right to cancel the service at any time, with a full or partial refund of the amount paid, at the company\u2019s sole discretion.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">7. A boarding fee of BD 10 per day will be charged if the pet is not collected on the same day following completion of the service.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">8. If the pet is not collected within three (3) days, My Pets reserves the right to hand over the pet to an adoption organization or another suitable party, without any obligation to disclose details to the owner.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">9. Customers are strictly prohibited from entering or remaining in the grooming area.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">10. Some pets may require sedation during grooming services, subject to professional veterinary assessment. Sedation charges will apply and will be billed by My Pets Clinic.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">11. If the owner fails to claim the pet within three (3) days from the service date, My Pets reserves the right to take all lawful and appropriate action regarding the pet.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">12. My Pets is not responsible for any lost, stolen, or damaged pet accessories before, during, or after the grooming service.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">13. My Pets shall not be held responsible and will not provide any compensation if the pet develops any disease, skin condition, ringworm, fungal infection, or similar health issues after the grooming service.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">14. If staff observe or suspect any signs of illness or disease in the pet, they reserve the right to:</p>\r\n      <p style=\"margin:0 0 0 12px !important; font-size:9px !important; line-height:1 !important;\">\u2022 Recommend veterinary consultation,</p>\r\n      <p style=\"margin:0 0 0 12px !important; font-size:9px !important; line-height:1 !important;\">\u2022 Stop the grooming service, or</p>\r\n      <p style=\"margin:0 0 0 12px !important; font-size:9px !important; line-height:1 !important;\">\u2022 Proceed with grooming in an isolation area, with additional charges applied.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">The owner will be fully responsible for any consequences resulting from proceeding under these circumstances.</p>\r\n\r\n      <p style=\"color:#c00; font-weight:bold; margin-top:30px !important; font-size:9px !important;\">\r\n        * I HAVE READ, UNDERSTOOD, AND ACCEPTED THE ABOVE TERMS AND CONDITIONS.\r\n      </p>\r\n    </td>\r\n\r\n    <td style=\"width:50%; vertical-align:top; text-align:right; padding:5px 3px 1px 3px !important; direction:rtl; font-size:9px !important; line-height:1 !important;\">\r\n\r\n      <h6 style=\"margin:3px 0 !important; font-size:9px !important;\">\r\n        \u0627\u062a\u0641\u0627\u0642\u064a\u0629 \u062a\u0642\u062f\u064a\u0645 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0628\u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629 \u0644\u062f\u0649 \u0645\u0627\u064a \u0628\u064a\u062a\u0633\r\n      </h6>\r\n\r\n      <h6 style=\"font-size:9px !important;\">\u0634\u0631\u0648\u0637 \u0648\u0642\u0648\u0627\u0646\u064a\u0646</h6>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">1. \u0644\u0627 \u062a\u062a\u062d\u0645\u0644 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0623\u064a \u0645\u0633\u0624\u0648\u0644\u064a\u0629\u060c \u0633\u0648\u0627\u0621 \u0643\u0627\u0646\u062a \u0645\u0628\u0627\u0634\u0631\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0645\u0628\u0627\u0634\u0631\u0629 \u0623\u0648 \u062a\u0628\u0639\u064a\u0629\u060c \u0639\u0646 \u0623\u064a \u0625\u0635\u0627\u0628\u0629 \u0623\u0648 \u0636\u0631\u0631 \u0623\u0648 \u062e\u0633\u0627\u0631\u0629 \u0642\u062f \u062a\u0635\u064a\u0628 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0623\u062b\u0646\u0627\u0621 \u0623\u0648 \u0628\u0639\u062f \u062e\u062f\u0645\u0629 \u0627\u0644\u0639\u0646\u0627\u064a\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0646\u0642\u0644.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">2. \u0644\u0627 \u062a\u062a\u062d\u0645\u0644 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0623\u064a \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0623\u064a \u0645\u0631\u0636 \u0623\u0648 \u0625\u0635\u0627\u0628\u0629 \u0623\u0648 \u062a\u0644\u0641 \u0623\u0648 \u0641\u0642\u062f\u0627\u0646 \u0642\u062f \u064a\u062a\u0639\u0631\u0636 \u0644\u0647 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0623\u062b\u0646\u0627\u0621 \u0623\u0648 \u0628\u0639\u062f \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0623\u0648 \u0627\u0644\u0646\u0627\u062a\u062c \u0639\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u064a \u0645\u0646 \u0645\u0646\u062a\u062c\u0627\u062a \u0623\u0648 \u0645\u0639\u062f\u0627\u062a \u0623\u0648 \u0645\u0631\u0627\u0641\u0642 \u0627\u0644\u0634\u0631\u0643\u0629.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">3. \u0644\u0627 \u062a\u062a\u062d\u0645\u0644 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0623\u064a \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0623\u064a \u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0628\u0627\u0644\u062a\u0639\u0648\u064a\u0636 \u0627\u0644\u062c\u0633\u062f\u064a \u0623\u0648 \u0627\u0644\u0646\u0641\u0633\u064a \u0623\u0648 \u0627\u0644\u0639\u0627\u0637\u0641\u064a \u0623\u0648 \u0627\u0644\u0645\u0639\u0646\u0648\u064a \u0623\u0648 \u0627\u0644\u0645\u0627\u0644\u064a.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">4. \u064a\u062d\u0642 \u0644\u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0631\u0641\u0636 \u0623\u0648 \u0625\u0644\u063a\u0627\u0621 \u062e\u062f\u0645\u0629 \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0645\u0631\u064a\u0636\u064b\u0627\u060c \u0645\u0635\u0627\u0628\u064b\u0627\u060c \u0639\u062f\u0648\u0627\u0646\u064a\u064b\u0627\u060c \u062d\u0627\u0645\u0644\u064b\u0627\u060c \u063a\u064a\u0631 \u0645\u064f\u0637\u0639\u0651\u0645\u060c \u0623\u0648 \u0643\u0627\u0646 \u0635\u063a\u064a\u0631 \u0627\u0644\u0633\u0646 \u062c\u062f\u064b\u0627 (\u062c\u0631\u0648 \u0623\u0648 \u0642\u0637\u0629 \u0635\u063a\u064a\u0631\u0629).</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">5. \u0648\u064a\u062c\u0648\u0632 \u0627\u0633\u062a\u062b\u0646\u0627\u0621\u064b \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062e\u062f\u0645\u0629 \u0641\u0642\u0637 \u0641\u064a \u062d\u0627\u0644 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0627\u0644\u0643 \u062e\u0637\u064a\u064b\u0627 \u0639\u0644\u0649 \u062a\u062d\u0645\u0651\u0644 \u0643\u0627\u0645\u0644 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0648\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u0645\u062a\u0631\u062a\u0628\u0629 \u0639\u0644\u0649 \u0630\u0644\u0643.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">6. \u062a\u062d\u062a\u0641\u0638 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0628\u0627\u0644\u062d\u0642 \u0641\u064a \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062e\u062f\u0645\u0629 \u0641\u064a \u0623\u064a \u0648\u0642\u062a\u060c \u0645\u0639 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639 \u0643\u0644\u064a\u064b\u0627 \u0623\u0648 \u062c\u0632\u0626\u064a\u064b\u0627\u060c \u062d\u0633\u0628 \u062a\u0642\u062f\u064a\u0631 \u0627\u0644\u0634\u0631\u0643\u0629.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">7. \u062a\u064f\u0641\u0631\u0636 \u0631\u0633\u0648\u0645 \u0625\u064a\u0648\u0627\u0621 \u0642\u062f\u0631\u0647\u0627 10 \u062f\u0646\u0627\u0646\u064a\u0631 \u0628\u062d\u0631\u064a\u0646\u064a\u0629 \u0639\u0646 \u0643\u0644 \u064a\u0648\u0645 \u0641\u064a \u062d\u0627\u0644 \u0639\u062f\u0645 \u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0641\u064a \u0646\u0641\u0633 \u064a\u0648\u0645 \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0629.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">8. \u0648\u0641\u064a \u062d\u0627\u0644 \u0639\u062f\u0645 \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u062e\u0644\u0627\u0644 \u062b\u0644\u0627\u062b\u0629 (3) \u0623\u064a\u0627\u0645\u060c \u064a\u062d\u0642 \u0644\u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0625\u0644\u0649 \u062c\u0647\u0629 \u062a\u0628\u0646\u0651\u064a \u0623\u0648 \u0637\u0631\u0641 \u0645\u0646\u0627\u0633\u0628 \u0622\u062e\u0631\u060c \u062f\u0648\u0646 \u0623\u064a \u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u0625\u0641\u0635\u0627\u062d \u0639\u0646 \u0623\u064a \u062a\u0641\u0627\u0635\u064a\u0644 \u0644\u0644\u0645\u0627\u0644\u0643.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">9. \u064a\u064f\u0645\u0646\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0645\u0646\u0639\u0627\u064b \u0628\u0627\u062a\u0627\u064b \u0645\u0646 \u0627\u0644\u062f\u062e\u0648\u0644 \u0623\u0648 \u0627\u0644\u0628\u0642\u0627\u0621 \u062f\u0627\u062e\u0644 \u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0628\u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">10. \u0642\u062f \u062a\u062a\u0637\u0644\u0628 \u0628\u0639\u0636 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u062e\u062f\u064a\u0631 \u0623\u062b\u0646\u0627\u0621 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u0648\u0630\u0644\u0643 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u0637\u0628\u064a\u0628 \u0627\u0644\u0628\u064a\u0637\u0631\u064a \u0627\u0644\u0645\u062e\u062a\u0635. \u062a\u064f\u0637\u0628\u0642 \u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u062e\u062f\u064a\u0631 \u0648\u064a\u062a\u0645 \u0627\u062d\u062a\u0633\u0627\u0628\u0647\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0639\u064a\u0627\u062f\u0629 \u0645\u0627\u064a \u0628\u064a\u062a\u0633.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">11. \u0641\u064a \u062d\u0627\u0644 \u0639\u062f\u0645 \u0645\u0637\u0627\u0644\u0628\u0629 \u0627\u0644\u0645\u0627\u0644\u0643 \u0628\u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u062e\u0644\u0627\u0644 \u062b\u0644\u0627\u062b\u0629 (3) \u0623\u064a\u0627\u0645 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u062a\u062d\u062a\u0641\u0638 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0628\u0627\u0644\u062d\u0642 \u0641\u064a \u0627\u062a\u062e\u0627\u0630 \u062c\u0645\u064a\u0639 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629 \u062a\u062c\u0627\u0647 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">12. \u0644\u0627 \u062a\u062a\u062d\u0645\u0644 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0623\u064a \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0641\u0642\u062f\u0627\u0646 \u0623\u0648 \u0633\u0631\u0642\u0629 \u0623\u0648 \u062a\u0644\u0641 \u0625\u0643\u0633\u0633\u0648\u0627\u0631\u0627\u062a \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0644\u064a\u0641\u0629 \u0642\u0628\u0644 \u0623\u0648 \u0623\u062b\u0646\u0627\u0621 \u0623\u0648 \u0628\u0639\u062f \u062e\u062f\u0645\u0629 \u0627\u0644\u0639\u0646\u0627\u064a\u0629.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">13. \u0644\u0627 \u062a\u062a\u062d\u0645\u0644 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0623\u064a \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0648\u0644\u0646 \u062a\u064f\u0642\u062f\u0651\u0645 \u0623\u064a \u062a\u0639\u0648\u064a\u0636 \u0641\u064a \u062d\u0627\u0644 \u0625\u0635\u0627\u0628\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0628\u0623\u064a \u0645\u0631\u0636 \u0623\u0648 \u062d\u0627\u0644\u0629 \u062c\u0644\u062f\u064a\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0641\u0637\u0631\u064a\u0627\u062a \u0623\u0648 \u0627\u0644\u0633\u0639\u0641\u0629 \u0623\u0648 \u0623\u064a \u0645\u0634\u0643\u0644\u0627\u062a \u0635\u062d\u064a\u0629 \u0645\u0645\u0627\u062b\u0644\u0629 \u062a\u0638\u0647\u0631 \u0628\u0639\u062f \u062e\u062f\u0645\u0629 \u0627\u0644\u0639\u0646\u0627\u064a\u0629.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\">14. \u0625\u0630\u0627 \u0644\u0627\u062d\u0638 \u0641\u0631\u064a\u0642 \u0627\u0644\u0639\u0645\u0644 \u0623\u064a \u0639\u0644\u0627\u0645\u0627\u062a \u0645\u0631\u0636\u064a\u0629 \u0623\u0648 \u0627\u0634\u062a\u0628\u0647 \u0641\u064a \u0625\u0635\u0627\u0628\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u060c \u064a\u062d\u0642 \u0644\u0647\u0645:</p>\r\n      <p style=\"margin:0 0 0 12px !important; font-size:9px !important; line-height:1 !important;\">\u2022 \u0627\u0644\u062a\u0648\u0635\u064a\u0629 \u0628\u0639\u0631\u0636 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0639\u0644\u0649 \u0637\u0628\u064a\u0628 \u0628\u064a\u0637\u0631\u064a\u060c</p>\r\n      <p style=\"margin:0 0 0 12px !important; font-size:9px !important; line-height:1 !important;\">\u2022 \u0625\u064a\u0642\u0627\u0641 \u062e\u062f\u0645\u0629 \u0627\u0644\u0639\u0646\u0627\u064a\u0629\u060c \u0623\u0648</p>\r\n      <p style=\"margin:0 0 0 12px !important; font-size:9px !important; line-height:1 !important;\">\u2022 \u0627\u0633\u062a\u0643\u0645\u0627\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 \u0641\u064a \u063a\u0631\u0641\u0629 \u0639\u0632\u0644 \u0645\u0639 \u062a\u0637\u0628\u064a\u0642 \u0631\u0633\u0648\u0645 \u0625\u0636\u0627\u0641\u064a\u0629.</p>\r\n\r\n      <p style=\"margin:0 !important; font-size:9px !important; line-height:1 !important;\"> \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0627\u0644\u0643 \u0645\u0633\u0624\u0648\u0644\u064b\u0627 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0639\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0639\u0648\u0627\u0642\u0628 \u0627\u0644\u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0627\u062a\u062e\u0627\u0630 \u0623\u064a \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a.</p>\r\n\r\n      <p style=\"color:#c00; font-weight:bold; margin-top:30px !important; font-size:9px !important;\">\r\n        \u00d7 \u0623\u064f\u0642\u0650\u0631\u0651 \u0628\u0623\u0646\u0646\u064a \u0642\u062f \u0642\u0631\u0623\u062a \u0648\u0641\u0647\u0645\u062a \u0648\u0648\u0627\u0641\u0642\u062a \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0623\u0639\u0644\u0627\u0647\r\n      </p>\r\n\r\n    </td>\r\n\r\n  </tr>\r\n</table>\r\n\r\n\r\n  <table style=\"width:100%; margin-top:5px; border-collapse:collapse;\">\r\n  <tr>\r\n\r\n    <td style=\"width:50%; padding:0; text-align:left;\">\r\n      <table style=\"width:100%; border-collapse:collapse;\">\r\n        <tr>\r\n    <td style=\"height:120px; vertical-align:bottom; text-align:center;\">\r\n            {% if doc.for_my_pet %}\r\n              <img src=\"{{ doc.for_my_pet }}\"style=\"max-width:220px; max-height:80px; display:block; margin:0 auto 6px;\" />\r\n            {% else %}\r\n              <div style=\"width:220px; height:80px; border-bottom:1px solid #333; margin:0 auto 6px;\"></div>\r\n            {% endif %}\r\n            <div style=\"font-size:12px;\">For My Pets</div>\r\n          </td>\r\n        </tr>\r\n      </table>\r\n    </td>\r\n\r\n    <td style=\"width:50%; padding:0; text-align:right;\">\r\n      <table style=\"width:100%; border-collapse:collapse;\">\r\n        <tr>\r\n          <td style=\"height:120px; vertical-align:bottom; text-align:center;\">\r\n            {% if doc.customer_signature %}\r\n              <img src=\"{{ doc.customer_signature }}\"\r\n                   style=\"max-width:220px; max-height:80px; display:block; margin:0 auto 6px;\" />\r\n            {% else %}\r\n              <div style=\"width:220px; height:80px; border-bottom:1px solid #333; margin:0 auto 6px;\"></div>\r\n            {% endif %}\r\n            <div style=\"font-size:12px;\">Customer Signature</div>\r\n          </td>\r\n        </tr>\r\n      </table>\r\n    </td>\r\n  </tr>\r\n</table>\r\n</div>",
