 "html": "<style id=label>\n\t.print-format table, .print-format tr, \n\t.print-format td, .print-format div, .print-format p {\n\t\tfont-family: arial;\n\t\tline-height: 100%;\n\t\tvertical-align: middle;\n\t  \n\t\twidth: 95%;\n\t}\n\n\t@media screen {\n\t\t.print-format {\n\t\t\twidth: 1.97in;\n\t\t\tpadding: 0.05in;\n\t\t\tmin-height: 0.97in;\n\t\t\t \n\t\t}\n\t}\n</style>\n\n{%- for row in doc.items -%}\n\n\n{% if row.dosage %}\n\n\t\t\n\t\t<p class=\"text-center\" style=\"font-size:8px\"><br>\n<b class=\"text-center\" style=\"font-size:12px\"> {{doc.company }}</b> \n<div class = \"flex justify-content\" style=\"font-size:9px\" > <div><b>{{doc.pb_sales_employee_name or '' }}  </b> </div></b>   \n\n<div style=\"font-size:8px\" ><b>PH: 39452112</b></div>\n</div>\n<div class = \"flex justify-content\" style=\"font-size:8px\" >\n    <div style=\"display:inline-block; max-width:60%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;\">Pet Name : {{doc.patient_name or ''}} </div></b>\n    <div style=\"font-size:8px\" >Date : {{ frappe.format(doc.posting_date, {'fieldtype':'Date'}) }}</div>\n\n\n\n</div>\n\n\n<div class = \"flex \" style=\"font-size:8px; overflow:hidden;\" >\n         <div style=\"display:inline-block; max-width:60%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;\">Owner : {{doc.customer_name}}</div>\n<div style=\"font-size:8px\" >Species : {{frappe.db.get_value(\"Patient\", doc.patient, \"vc_species\") or ''}}</div>\n\n</div>\n\n\n<div style=\"font-size:8px;\" >\n<b > Medication : </b>{{row.item_name }} <br>\n<b style=\"font-size:8px\">Dosage: </b> {{row.dosage or ''}}\n</div>\n\n\n<div class=\"page-break\"></div>\n\n\n{% endif %}\n\n{%- endfor -%}\n",
