 "font_size": 14,
 "html": "<div>\r\n  {% if letter_head and not no_letterhead -%}\r\n    <div class=\"letter-head\">{{ letter_head }}</div>\r\n    <hr>\r\n  {%- endif %}\r\n\r\n  <h2 style=\"text-align:center; margin:2px 0;font-size:14px;\"><b>REGISTRATION FORM</b></h2>\r\n  <hr>\r\n\r\n  <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0; font-size:12px;\">\r\n    <tr>\r\n      <td style=\"text-align:left; width:50%; padding:0;\">\r\n        <strong>Date:</strong> {{ doc.get_formatted(\"date\") }}\r\n      </td>\r\n      <td style=\"text-align:right; width:50%; padding:0;\">\r\n        <strong>No:</strong> {{ doc.name }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n  <hr style=\"margin:2px 0;\">\r\n  <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0;font-size:12px;\">\r\n    <tr>\r\n      <td style=\"text-align:left; width:50%; padding:0;\">\r\n        <strong>Client's Name:</strong> {{ doc.clients_name }}\r\n      </td>\r\n      <td style=\"text-align:right; width:50%; padding:0;\">\r\n        <strong>Address:</strong> {{ doc.address or '' }}\r\n      </td>\r\n    </tr>\r\n    <tr style=\"white-space:nowrap;\">\r\n    <td style=\"width:33%; text-align:left;\">\r\n      <strong>CPR No:</strong> {{ doc.cpr_no or ''}}\r\n    </td>\r\n    <td style=\"width:33%; text-align:left;\">\r\n      <strong>Mobile No:</strong> {{ doc.mobile_no or ''}}\r\n    </td>\r\n    <td style=\"width:34%; text-align:left;\">\r\n      <strong>E-mail:</strong> {{ doc.email or '' }}\r\n    </td>\r\n  </tr>.\r\n  </table>\r\n  <hr style=\"margin:2px 0;\">\r\n <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0;font-size:12px;\">\r\n    <tr style=\"white-space:nowrap;\">\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Patient's Name:</strong> {{ doc.patients_name }}\r\n      </td>\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>DOB/Age:</strong> {{ doc.dobage or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:34%; padding:0;\">\r\n        <strong>Sex:</strong> {{ doc.sex or '' }}\r\n      </td>\r\n    </tr>\r\n    <tr style=\"white-space:nowrap;\">\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Species:</strong> {{ doc.species or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Breed:</strong> {{ doc.breed or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:34%; padding:0;\">\r\n        <strong>Spayed/Neutered(Y/N):</strong> {{ doc.spayedneutered or '' }}\r\n      </td>\r\n    </tr>\r\n    <tr style=\"white-space:nowrap;\">\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Color:</strong> {{ doc.color or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Body Weight:</strong> {{ doc.body_wt or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:34%; padding:0;\">\r\n        <strong>Microchip No:</strong> {{ doc.microchip_number or '' }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n  <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0; font-size:12px;\">\r\n    <tr>\r\n      <td style=\"text-align:left; width:50%; padding:0;\">\r\n        <strong>Name and Date of last vaccine:</strong> {{ doc.name_and_date_of_last_vaccine }}\r\n      </td>\r\n      <td style=\"text-align:right; width:50%; padding:0;\">\r\n        <strong>Name and Date of last Deworming:</strong> {{ doc.name_and_date_of_last_deworming }}\r\n      </td>\r\n    </tr>\r\n    <tr>\r\n      <td style=\"text-align:left; width:50%; padding:0;\">\r\n        <strong>Regular Diet:</strong> {{ doc.regular_diet }}\r\n      </td>\r\n      <td style=\"text-align:right; width:50%; padding:0;\">\r\n        <strong>Any Alleries:</strong> {{ doc.any_allergies }}\r\n      </td>\r\n    </tr>\r\n     <tr>\r\n      <td style=\"text-align:left; width:50%; padding:0;\">\r\n        <strong>Previous veterinarian:</strong> {{ doc.previous_veterinarian }}\r\n      </td>\r\n    </tr>\r\n  </table><br><br>\r\n  <h2 style=\"text-align:center; margin:2px 0;font-size:14px;\"><b>Authorization</b></h2>\r\n  <p>I am the Owner or responsible party for the above described Pet and have the authority to consent\r\n for treatment. I assume full responsibility for all charges incurred for the care and treatment of my pet.\r\nI understand that I am required to pay in full for services rendered and that a deposit may be\r\nrequired for Surgical/anesthetic procedures. </p><br><br>\r\n<p style=\"text-align:left; width: 50%;font-size:11px;\">Note: Please read carefully consent form on back side of this\r\npage and after that do signature.</p><br><br>\r\n<p style=\"text-align:left; width: 50%;font-size:11px; color:red;\">* I HAVE READ AND ACCEPT THE ABOVE TERMS AND CONDITIONS</p><br><br><br><br><br>\r\n<p style=\"text-align:right;\">\r\n  {% if doc.client_signature and doc.client_signature != \"/assets/frappe/images/signature-placeholder.png\" %}\r\n    <img src=\"{{ doc.client_signature }}\" \r\n         style=\"width:120px; height:auto; border:0;\" />\r\n    <br><small>Client Signature</small>\r\n  {% else %}\r\n    ___________________________<br>\r\n    <small>Client Signature</small>\r\n  {% endif %}\r\n</p>\r\n\r\n\r\n</div>\r\n",
