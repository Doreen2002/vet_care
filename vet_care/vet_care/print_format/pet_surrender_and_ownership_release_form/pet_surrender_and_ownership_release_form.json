 "html": "<div>\r\n {% set my_letterhead = frappe.db.get_value(\"Letter Head\", \"My Pets Clinic\", \"content\") %}\r\n\r\n{% if my_letterhead and not no_letterhead %}\r\n    <div class=\"letter-head\">{{ my_letterhead }}</div>\r\n   \r\n{% endif %}\r\n\r\n  <h2 style=\"text-align:center; margin:2px 0;font-size:14px;\"><b>PET SURRENDER AND OWNERSHIP RELEASE FORM</b></h2>\r\n  <hr>\r\n\r\n  <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0; font-size:12px;\">\r\n    <tr>\r\n      <td style=\"text-align:left; width:50%; padding:0;\">\r\n        <strong>Date:</strong> {{ doc.get_formatted(\"date\") or '' }}\r\n      </td>\r\n      <td style=\"text-align:right; width:50%; padding:0;\">\r\n        <strong>No:</strong> {{ doc.name or '' }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n  <hr style=\"margin:2px 0;\">\r\n  <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0;font-size:12px;\">\r\n    <tr>\r\n      <td style=\"width:33%; text-align:left;\">\r\n        <strong>Owner's Name:</strong> {{ doc.owners_name or ''  }}\r\n      </td>\r\n      <td style=\"width:34%; text-align:left;\">\r\n        <strong>CPR / ID:</strong> {{ doc.cpr__id or '' }}\r\n      </td>\r\n      <td style=\"width:33%; text-align:left;\">\r\n      <strong>Phone Number:</strong> {{ doc.phone_number or ''}}\r\n    </td>\r\n    </tr>\r\n  </table>\r\n  <hr style=\"margin:2px 0;\">\r\n <table style=\"width:100%; border-collapse:collapse; margin:0; padding:0;font-size:12px;\">\r\n    <tr style=\"white-space:nowrap;\">\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Pet Name:</strong> {{ doc.pets_name or ''}}\r\n      </td>\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Species:</strong> {{ doc.species or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Breed:</strong> {{ doc.breed or '' }}\r\n      </td>\r\n    </tr>\r\n    <tr style=\"white-space:nowrap;\">\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Color / Markings:</strong> {{ doc.color__markings or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Date of Birth / Age:</strong> {{ frappe.utils.formatdate(doc.date_of_birth__age) or '' }}\r\n      </td>\r\n      <td style=\"text-align:left; width:33%; padding:0;\">\r\n        <strong>Microchip No:</strong> {{ doc.microchip_no or '' }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n  <p><b>Statement of Voluntary Surrender</b></p>\r\n<div style=\"padding:2px;\">\r\n  I, the undersigned, hereby voluntarily surrender full ownership and custody of the above-mentioned pet to My Pets Veterinary Center.  I confirm that I am the legal owner of this pet and have full authority to make this decision.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  I understand and agree that :\r\n  I permanently relinquish all ownership rights and claims to this pet.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  I will not request to take the pet back at any time in the future.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  I waive any right to receive information about the pet\u2019s condition, location, or future status.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  The clinic has full discretion to provide medical treatment, rehome, or make any necessary decision regarding the pet.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  I confirm that this decision is made voluntarily, without pressure or compensation.\r\n</div>\r\n<div style=\"direction: rtl; text-align: right;\">\r\n<p><b></b>\r\n  \u0628\u064a\u0627\u0646 \u0627\u0644\u062a\u0646\u0627\u0632\u0644 \u0627\u0644\u0637\u0648\u0639\u064a\r\n</p>\r\n\r\n\r\n<div style=\"padding:2px;\">\r\n  \u0623\u0646\u0627 \u0627\u0644\u0645\u0648\u0642\u0651\u0639 \u0623\u062f\u0646\u0627\u0647\u060c \u0623\u062a\u0646\u0627\u0632\u0644 \u0637\u0648\u0627\u0639\u064a\u0629\u064b \u0639\u0646 \u0645\u0644\u0643\u064a\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0627\u0644\u0645\u0630\u0643\u0648\u0631 \u0623\u0639\u0644\u0627\u0647 \u0648\u062d\u0636\u0627\u0646\u062a\u0647 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u0635\u0627\u0644\u062d \u0645\u0631\u0643\u0632 \u0645\u0627\u064a \u0628\u064a\u062a\u0633 \u0627\u0644\u0628\u064a\u0637\u0631\u064a. \u0623\u0624\u0643\u0651\u062f \u0623\u0646\u0646\u064a \u0627\u0644\u0645\u0627\u0644\u0643 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0644\u0647\u0630\u0627 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0648\u0644\u062f\u064a\u0651 \u0643\u0627\u0645\u0644 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629 \u0644\u0627\u062a\u062e\u0627\u0630 \u0647\u0630\u0627 \u0627\u0644\u0642\u0631\u0627\u0631.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  \u0623\u062f\u0631\u0643 \u0648\u0623\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0645\u0627 \u064a\u0644\u064a:\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  \u0623\u062a\u0646\u0627\u0632\u0644 \u0646\u0647\u0627\u0626\u064a\u064b\u0627 \u0639\u0646 \u062c\u0645\u064a\u0639 \u062d\u0642\u0648\u0642 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0648\u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0647\u0630\u0627 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  \u0644\u0646 \u0623\u0637\u0644\u0628 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u0645\u0633\u062a\u0642\u0628\u0644\u0627\u064b.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  \u0623\u062a\u0646\u0627\u0632\u0644 \u0639\u0646 \u0623\u064a \u062d\u0642 \u0641\u064a \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0648\u0644 \u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 \u0627\u0644\u0623\u0644\u064a\u0641 \u0623\u0648 \u0645\u0648\u0642\u0639\u0647 \u0623\u0648 \u0648\u0636\u0639\u0647 \u0627\u0644\u0645\u0633\u062a\u0642\u0628\u0644\u064a.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  \u0644\u0644\u0645\u0631\u0643\u0632 \u0643\u0627\u0645\u0644 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629 \u0641\u064a \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0639\u0644\u0627\u062c \u0627\u0644\u0637\u0628\u064a \u0623\u0648 \u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u0637\u064a\u0646\u0647 \u0623\u0648 \u0627\u062a\u062e\u0627\u0630 \u0623\u064a \u0642\u0631\u0627\u0631 \u0636\u0631\u0648\u0631\u064a \u0628\u0634\u0623\u0646\u0647.\r\n</div>\r\n\r\n<div style=\"padding:2px;\">\r\n  \u0623\u0624\u0643\u062f \u0623\u0646 \u0647\u0630\u0627 \u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u062a\u0651\u064f\u062e\u0630 \u0637\u0648\u0627\u0639\u064a\u0629\u064b \u062f\u0648\u0646 \u0623\u064a \u0636\u063a\u0637 \u0623\u0648 \u062a\u0639\u0648\u064a\u0636.\r\n</div>\r\n</div>\r\n <table style=\"width:100%; margin-top:20px; border-collapse:collapse;\">\r\n  <tr>\r\n\r\n    <td style=\"width:50%; padding:0; text-align:left;\">\r\n      <table style=\"width:100%; border-collapse:collapse;\">\r\n        <tr>\r\n    <td style=\"height:120px; vertical-align:bottom; text-align:center;\">\r\n            {% if doc.owners_signature %}\r\n              <img src=\"{{ doc.owners_signature }}\"style=\"max-width:220px; max-height:80px; display:block; margin:0 auto 6px;\" />\r\n            {% else %}\r\n              <div style=\"width:220px; height:80px; border-bottom:1px solid #333; margin:0 auto 6px;\"></div>\r\n            {% endif %}\r\n            <div style=\"font-size:12px;\">OWNER'S SIGNATURE</div>\r\n          </td>\r\n        </tr>\r\n      </table>\r\n    </td>\r\n\r\n    <td style=\"width:50%; padding:0; text-align:right;\">\r\n      <table style=\"width:100%; border-collapse:collapse;\">\r\n        <tr>\r\n          <div style=\"font-size:12px; margin-bottom:5px;\">\r\n           <strong>Clinic Representative:</strong> {{ doc.clinic_representative_name or '' }}\r\n          </div>\r\n          <td style=\"height:120px; vertical-align:bottom; text-align:center;\">\r\n            {% if doc.signature %}\r\n              <img src=\"{{ doc.signature }}\"\r\n                   style=\"max-width:220px; max-height:80px; display:block; margin:0 auto 6px;\" />\r\n            {% else %}\r\n              <div style=\"width:220px; height:80px; border-bottom:1px solid #333; margin:0 auto 6px;\"></div>\r\n            {% endif %}\r\n            <div style=\"font-size:12px;\">SIGNATURE</div>\r\n          </td>\r\n        </tr>\r\n      </table>\r\n    </td>\r\n  </tr>\r\n</table>\r\n\r\n\r\n\r\n</div>",
